<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />

  <PropertyGroup>
    <Version>1.0.0</Version>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>RainbowSense.VisualStudio</RootNamespace>
    <AssemblyName>RainbowSense.VisualStudio</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <UseCodebase>true</UseCodebase>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <VSSDKTargetPlatformRegRootSuffix>RainbowSense</VSSDKTargetPlatformRegRootSuffix>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnabledefaultEmbeddedResourceItems>false</EnabledefaultEmbeddedResourceItems>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <CreateVsixContainer>true</CreateVsixContainer>
    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="$(RainbowSenseVisualStudioSdkVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="$(RainbowSenseRoslynVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RainbowSenseRoslynVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix $(VSSDKTargetPlatformRegRootSuffix)</StartArguments>
  </PropertyGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />

  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="Overview.md" />
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="VSPackage.cs" />
    <Compile Include="Configuration\RainbowSenseOptions.cs" />
    <Compile Include="Configuration\RainbowSenseOptionsStore.cs" />
    <Compile Include="Completion\RainbowCompletionContext.cs" />
    <Compile Include="Completion\RainbowCompletionItems.cs" />
    <Compile Include="Completion\RainbowCompletionBuilder.cs" />
    <Compile Include="Completion\Providers\RainbowSenseCompletionProvider.cs" />
    <Compile Include="Completion\Providers\DevExpressCompletionProvider.cs" />
    <Compile Include="Completion\Catalogs\BlazorDirectivesCatalog.cs" />
    <Compile Include="Completion\Catalogs\BlazorInjectablesCatalog.cs" />
    <Compile Include="Completion\Catalogs\RazorComponentsCatalog.cs" />
    <Compile Include="Completion\Catalogs\DevExpressComponentsCatalog.cs" />
    <Compile Include="Completion\Catalogs\ComponentSnippetsCatalog.cs" />
    <Compile Include="Completion\Catalogs\DevExpressMembersCatalog.cs" />
    <Compile Include="Completion\Catalogs\RazorMembersCatalog.cs" />
    <Compile Include="Completion\Catalogs\DevExpressNamespacesCatalog.cs" />
  </ItemGroup>

</Project>